// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the NFC dialog > on a device that cannot write tags 1`] = `
<div
  aria-label="nfc.linkTitle"
  aria-modal="true"
  class="slot-modal"
  role="dialog"
  style="max-width: 400px;"
  tabindex="-1"
>
  <div
    class="slot-popup-header"
  >
    <span
      class="slot-popup-title"
    >
      nfc.linkTitle
    </span>
    <button
      aria-label="Close"
      class="slot-popup-close"
    >
      ×
    </button>
  </div>
  <div
    style="padding: 1rem;"
  >
    <p
      style="font-size: 0.85rem; color: var(--color-text-muted); margin: 0px 0px 1rem;"
    >
      nfc.linkDescription
    </p>
    <div
      style="font-size: 0.8rem; color: var(--color-text-muted); word-break: break-all; margin-bottom: 1rem; padding: 0.5rem; background: var(--color-surface-raised); border-radius: var(--radius-sm);"
    >
      <strong>
        URL:
      </strong>
       
      http://localhost:3000/nfc/rack/r1
    </div>
    <div
      style="font-size: 0.85rem; color: var(--color-text-muted);"
    >
      <p
        style="margin: 0px 0px 0.5rem; font-weight: 600;"
      >
        nfc.notSupported
      </p>
      <p
        style="margin: 0px;"
      >
        nfc.manualInstructions
      </p>
    </div>
    <div
      style="display: flex; gap: 0.5rem; margin-top: 1rem; justify-content: flex-end;"
    >
      <button
        class="btn btn-primary btn-small"
      >
        nfc.markAsLinked
      </button>
    </div>
  </div>
</div>
`;

exports[`the new-rack form > for a grid, the type the form opens on 1`] = `
<div
  class="new-rack-section"
>
  <form
    class="card new-rack-form"
  >
    <h3>
      racks.newRackTitle
    </h3>
    <div
      data-rack-type="grid"
    >
      <button
        type="button"
      >
        choose-cabinet
      </button>
    </div>
    <div
      class="new-rack-fields"
    >
      <div
        class="form-group"
      >
        <label>
          racks.nameLabel
        </label>
        <input
          placeholder="racks.namePlaceholder"
          required=""
          type="text"
          value=""
        />
      </div>
      <div
        class="form-group"
      >
        <label>
          racks.groupLabel
        </label>
        <input
          list="new-rack-group-options"
          maxlength="40"
          placeholder="racks.groupPlaceholder"
          type="text"
          value=""
        />
        <datalist
          id="new-rack-group-options"
        />
        <small
          class="help-text"
        >
          racks.groupHint
        </small>
      </div>
      <div
        class="form-group"
      >
        <label>
          racks.rowsLabel
        </label>
        <input
          inputmode="numeric"
          max="20"
          min="1"
          type="number"
          value="4"
        />
      </div>
      <div
        class="form-group"
      >
        <label>
          racks.colsLabel
        </label>
        <input
          inputmode="numeric"
          max="20"
          min="1"
          type="number"
          value="8"
        />
      </div>
      <div
        class="form-group"
      >
        <label>
          racks.doubleHeightRowsLabel
        </label>
        <input
          placeholder="racks.doubleHeightRowsPlaceholder"
          type="text"
          value=""
        />
        <small
          style="color: var(--color-text-muted); font-size: 0.75rem;"
        >
          racks.doubleHeightRowsHelp
        </small>
      </div>
      <button
        class="btn btn-secondary new-rack-preview-toggle "
        type="button"
      >
        racks.preview
      </button>
      <button
        class="btn btn-primary"
        type="submit"
      >
        racks.createRack
      </button>
    </div>
    <div
      class="new-rack-preview-hint"
    >
      racks.totalSlots
      : 
      32
    </div>
  </form>
</div>
`;

