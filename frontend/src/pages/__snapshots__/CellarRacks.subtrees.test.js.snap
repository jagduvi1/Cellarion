exports[`the slot popups > a slot with a bottle 1`] = `
<div
  aria-labelledby="slot-popup-heading"
  aria-modal="true"
  class="slot-modal"
  role="dialog"
  tabindex="-1"
>
  <div
    class="slot-popup-header"
