        class="form-group"
      >
        <label>
          <input
            disabled=""
            type="checkbox"
          />
           
          racks.cabinetHeadToTailLabel
        </label>
        <small
          style="color: var(--color-text-muted); font-size: 0.75rem;"
        >
          racks.cabinetHeadToTailNeedsSingle
        </small>
      </div>
      <button
        class="btn btn-secondary new-rack-preview-toggle "
        type="button"
      >
        racks.preview
      </button>
      <button
        class="btn btn-primary"
        type="submit"
      >
        racks.createRack
      </button>
    </div>
    <div
      class="new-rack-preview-hint"
    >
      racks.totalSlots
      : 
      60
    </div>
  </form>
  <span
    data-beta="cabinetHeadToTail"
  />
  <span
    data-beta="cabinetSideways"
  />
</div>
`;

