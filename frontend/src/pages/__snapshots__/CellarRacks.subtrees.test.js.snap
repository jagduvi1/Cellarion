      aria-label="Close"
      class="slot-popup-close"
    >
      ×
    </button>
  </div>
  <div
    class="slot-bottle-detail"
  >
    <div
      class="slot-detail-info"
    >
      <h4>
        Cuvée Exemple
      </h4>
      <p
        class="slot-detail-producer"
      >
        Domaine Exemple
      </p>
      <p
        class="slot-detail-meta"
      >
        <span
          class="slot-bottle-type-dot type-red"
        />
        statistics.typeLabels.red
         · 
        2015
      </p>
    </div>
  </div>
