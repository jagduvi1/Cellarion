exports[`the slot popups > a free slot, once its picker has listed the unplaced bottles 1`] = `
<div
  aria-labelledby="slot-popup-heading"
  aria-modal="true"
  class="slot-modal"
  role="dialog"
  tabindex="-1"
>
  <div
    class="slot-popup-header"
  >
    <span
      class="slot-popup-title"
      id="slot-popup-heading"
    >
      racks.slotPlaceBottle:{"position":3}
    </span>
    <button
      aria-label="Close"
      class="slot-popup-close"
    >
      ×
    </button>
  </div>
  <input
    aria-label="racks.searchWines"
    class="slot-search"
    placeholder="racks.searchWines"
    type="text"
    value=""
  />
  <div
    class="slot-bottle-list"
  >
    <div
      class="slot-bottle-item"
      role="button"
      tabindex="0"
    >
      <span
        aria-hidden="true"
        class="slot-bottle-type-dot type-red"
      />
      <div
        class="slot-bottle-info"
      >
        <strong>
          Château Exemple
        </strong>
        <span
          class="slot-bottle-meta"
        >
          Domaine Exemple
           · 
          2015
        </span>
      </div>
    </div>
  </div>
  <div
    class="slot-popup-actions"
  >
    <button
      class="btn btn-secondary btn-small"
    >
      racks.disableSlot
    </button>
  </div>
</div>
`;

