  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "mcp:e2e": "node src/mcp/e2e.js",
    "mcp:eval": "node src/mcp/eval/run.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.55.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.1.5",
    "form-data": "^4.0.6",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mailgun.js": "^12.7.0",
    "meilisearch": "^0.58.0",
    "mongoose": "^8.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "passport": "^0.7.0",
