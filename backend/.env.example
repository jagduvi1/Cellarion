# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongo:27017/winecellar

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRES_IN=15m

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
# In the Docker setup nginx serves the app on port 80 — use http://localhost.
# Only bare-metal `npm start` dev serves the frontend on :3000.
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost:5000

# ── Search (Meilisearch) ─────────────────────────────────────────────────────
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=change-me-in-production
MEILI_SEARCH_KEY=

# ── Vector Database (Qdrant) ──────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333

# ── Image Processing ─────────────────────────────────────────────────────────
REMBG_URL=http://rembg:5000

# ── Email (Mailgun) — optional, email verification disabled without these ────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
MAILGUN_API_URL=

# ── AI Services — optional ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Self-hosted AI: set AI_PROVIDER=openai to use any OpenAI-compatible endpoint
# (Ollama, LM Studio, vLLM) instead of Anthropic. AI_MODEL is then required.
AI_PROVIDER=
OPENAI_BASE_URL=
OPENAI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=
OPENAI_TIMEOUT_MS=
# Self-hosted embeddings: EMBEDDING_PROVIDER=openai replaces Voyage AI.
# EMBEDDING_MODEL + EMBEDDING_DIMENSION are then required; base URL/key fall
# back to OPENAI_BASE_URL/OPENAI_API_KEY. Changing these needs a full re-embed.
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
EMBEDDING_TIMEOUT_MS=

# ── Super Admin — optional ───────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_IPS=

# ── Web Push Notifications — optional ────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ── Stripe Payments — optional ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUPPORTER_PRICE_ID=
STRIPE_PATRON_PRICE_ID=

# ── Logging & Auditing ───────────────────────────────────────────────────────
LOG_LEVEL=info
AUDIT_TTL_DAYS=365

# ── SEO — optional ───────────────────────────────────────────────────────────
INDEXNOW_KEY=
