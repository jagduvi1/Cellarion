# Shell scripts must always check out with LF endings — CRLF breaks the
# shebang and `set` parsing when they run on the Linux server.
*.sh text eol=lf

# systemd unit files are deployed on the Linux host; force LF so the
# directives parse cleanly.
*.service text eol=lf
*.timer   text eol=lf

# Import-parser test fixtures are byte-exact vectors — encodings (UTF-8 vs
# Windows-1252) and line endings (CRLF vs LF) are the thing under test.
# Never normalize them.
frontend/src/utils/__fixtures__/** -text
