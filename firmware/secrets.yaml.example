# Copy to secrets.yaml (gitignored — NEVER commit the real file) and fill in.

wifi_ssid: "YourWifiName"
wifi_password: "YourWifiPassword"

# Any random string; protects over-the-air firmware updates on your LAN.
ota_password: "change-me-to-something-random"

# From Cellarion: Settings → Climate devices → Add device (shown once).
# Keep the "Bearer " prefix.
cellarion_token: "Bearer cel_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Hosted: https://cellarion.app/api/climate/ingest
# Self-hosted (LAN): http://<your-server-ip>/api/climate/ingest
cellarion_ingest_url: "https://cellarion.app/api/climate/ingest"
